//@version=5
indicator("Smart Money Concepts - Refined", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// --- Inputs ---
pivot_length = input.int(10, "Pivot Lookback Length (for obvious sweeps)")
sweep_dist_mult = input.float(0.5, "Sweep Distance Multiplier (ATR)", minval=0)
show_fvg = input.bool(true, "Show Fair Value Gaps")
show_ob = input.bool(true, "Show Order Blocks")
show_liquidity = input.bool(true, "Show Liquidity Sweeps")
fvg_color_bull = input.color(color.new(color.green, 80), "Bullish FVG Color")
fvg_color_bear = input.color(color.new(color.red, 80), "Bearish FVG Color")
ob_color_bull = input.color(color.new(color.blue, 70), "Bullish OB Color")
ob_color_bear = input.color(color.new(color.orange, 70), "Bearish OB Color")

// --- State Variables ---
var float last_ph = na
var float last_pl = na
var bool has_choch_bull = false
var bool has_choch_bear = false
var bool is_bullish = false // Current trend state

// POI Tracking
var float last_bull_ob_high = na
var float last_bull_ob_low = na
var float last_bear_ob_high = na
var float last_bear_ob_low = na

// --- Pivots & Liquidity ---
ph = ta.pivothigh(high, pivot_length, pivot_length)
pl = ta.pivotlow(low, pivot_length, pivot_length)

if not na(ph)
    last_ph := ph
if not na(pl)
    last_pl := pl

atr = ta.atr(14)
dist_threshold = atr * sweep_dist_mult

// Obvious Liquidity Grab (Wick above/below pivot, but body close inside)
// Distance requirement: wick must extend significantly beyond the pivot
is_liquidity_grab_high = high > last_ph + dist_threshold and close < last_ph and show_liquidity
is_liquidity_grab_low = low < last_pl - dist_threshold and close > last_pl and show_liquidity

plotshape(is_liquidity_grab_high, "Liquidity Sweep High", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(is_liquidity_grab_low, "Liquidity Sweep Low", shape.triangleup, location.belowbar, color.green, size=size.small)

// --- Market Structure Shift (CHoCH) ---
// Candle wicks are not CHoCH -> Close must be above/below
choch_bull = not is_bullish and close > last_ph
choch_bear = is_bullish and close < last_pl

if choch_bull
    is_bullish := true
    has_choch_bull := true
    has_choch_bear := false // Reset bearish structure

if choch_bear
    is_bullish := false
    has_choch_bear := true
    has_choch_bull := false // Reset bullish structure

plotshape(choch_bull, "CHoCH Bullish", shape.labelup, location.belowbar, color.green, text="CHoCH", textcolor=color.white)
plotshape(choch_bear, "CHoCH Bearish", shape.labeldown, location.abovebar, color.red, text="CHoCH", textcolor=color.white)

// --- Break of Structure (BOS) ---
// Valid BOS only AFTER a CHoCH has occurred in that direction
bos_bull = is_bullish and has_choch_bull and ta.crossover(close, last_ph)
bos_bear = not is_bullish and has_choch_bear and ta.crossunder(close, last_pl)

plotshape(bos_bull, "BOS Bullish", shape.arrowup, location.belowbar, color.gray, text="BOS")
plotshape(bos_bear, "BOS Bearish", shape.arrowdown, location.abovebar, color.gray, text="BOS")

// --- Fair Value Gaps (FVG) ---
// 3 consecutive color candles with a gap
bullish_fvg = show_fvg and (low[0] > high[2]) and (close[0] > open[0]) and (close[1] > open[1]) and (close[2] > open[2])
bearish_fvg = show_fvg and (high[0] < low[2]) and (close[0] < open[0]) and (close[1] < open[1]) and (close[2] < open[2])

var box last_fvg_box = na
if bullish_fvg
    last_fvg_box := box.new(bar_index[2], low[0], bar_index, high[2], bgcolor=fvg_color_bull, border_color=na)
if bearish_fvg
    last_fvg_box := box.new(bar_index[2], high[0], bar_index, low[2], bgcolor=fvg_color_bear, border_color=na)

// --- Order Blocks (OB) ---
if show_ob
    if bos_bull or choch_bull
        int ob_index = 0
        for i = 1 to 10
            if close[i] < open[i]
                ob_index := i
                break
        last_bull_ob_high := high[ob_index]
        last_bull_ob_low := low[ob_index]
        box.new(bar_index - ob_index, last_bull_ob_high, bar_index - ob_index + 1, last_bull_ob_low, bgcolor=ob_color_bull, border_color=color.blue, extend=extend.right)

    if bos_bear or choch_bear
        int ob_index = 0
        for i = 1 to 10
            if close[i] > open[i]
                ob_index := i
                break
        last_bear_ob_high := high[ob_index]
        last_bear_ob_low := low[ob_index]
        box.new(bar_index - ob_index, last_bear_ob_high, bar_index - ob_index + 1, last_bear_ob_low, bgcolor=ob_color_bear, border_color=color.orange, extend=extend.right)

// --- Optimal Entry Signal ---
// Entry should be after a valid BOS + Retracement into POI (OB or FVG)
// Tracking recent BOS
var int last_bos_bull_index = 0
var int last_bos_bear_index = 0

if bos_bull
    last_bos_bull_index := bar_index
if bos_bear
    last_bos_bear_index := bar_index

// Entry condition: Price touches the last OB after a BOS
long_entry = is_bullish and (bar_index - last_bos_bull_index < 50) and ta.crossunder(low, last_bull_ob_high) and low > last_bull_ob_low
short_entry = not is_bullish and (bar_index - last_bos_bear_index < 50) and ta.crossover(high, last_bear_ob_low) and high < last_bear_ob_high

plotshape(long_entry, "Optimal Entry Long", shape.circle, location.belowbar, color.yellow, size=size.medium, text="ENTRY")
plotshape(short_entry, "Optimal Entry Short", shape.circle, location.abovebar, color.yellow, size=size.medium, text="ENTRY")

alertcondition(long_entry, "Long Entry Signal", "Smart Money Long Entry Detected")
alertcondition(short_entry, "Short Entry Signal", "Smart Money Short Entry Detected")
